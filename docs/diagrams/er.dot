digraph ER {
  graph [rankdir=TB, nodesep=0.3, ranksep=0.55, fontname="DejaVu Sans", pad=0.15, bgcolor="white"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10, dir=both, arrowtail=tee, arrowhead=crow, color="#333333"];
  USER [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#d9e2f3"><b>USER</b></td></tr><tr><td align="left"><b>PK</b> <u>user_id</u></td></tr><tr><td align="left" >login</td></tr><tr><td align="left" >role</td></tr></table>>];
  STUDENT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#d9e2f3"><b>STUDENT</b></td></tr><tr><td align="left"><b>PK</b> <u>student_id</u></td></tr><tr><td align="left" >full_name</td></tr></table>>];
  PERIOD [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#d9e2f3"><b>PERIOD</b></td></tr><tr><td align="left"><b>PK</b> <u>period_id</u></td></tr><tr><td align="left" >name</td></tr><tr><td align="left" >start_date</td></tr><tr><td align="left" >end_date</td></tr></table>>];
  CRITERION [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#d9e2f3"><b>CRITERION</b></td></tr><tr><td align="left"><b>PK</b> <u>criterion_id</u></td></tr><tr><td align="left" >code</td></tr><tr><td align="left" >title</td></tr></table>>];
  RECORD [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e2efd9"><b>STUDENT_RECORD</b></td></tr><tr><td align="left"><b>PK</b> <u>record_id</u></td></tr><tr><td align="left"><b>FK</b> student_id</td></tr><tr><td align="left"><b>FK</b> period_id</td></tr><tr><td align="left" >avg_score</td></tr><tr><td align="left" >debts</td></tr><tr><td align="left" >has_social_certificate</td></tr><tr><td align="left"><b>FK</b> entered_by</td></tr></table>>];
  ENTRY [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e2efd9"><b>SCORE_ENTRY</b></td></tr><tr><td align="left"><b>PK</b> <u>entry_id</u></td></tr><tr><td align="left"><b>FK</b> record_id</td></tr><tr><td align="left"><b>FK</b> criterion_id</td></tr><tr><td align="left" >points</td></tr><tr><td align="left"><b>FK</b> awarded_by</td></tr><tr><td align="left" >comment</td></tr><tr><td align="left" >created_at</td></tr></table>>];
  RULESET [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#fbe5d6"><b>RULE_SET</b></td></tr><tr><td align="left"><b>PK</b> <u>version</u></td></tr><tr><td align="left" >weights</td></tr><tr><td align="left" >max_points</td></tr><tr><td align="left" >levels</td></tr><tr><td align="left"><b>FK</b> created_by</td></tr></table>>];
  SRULE [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#fbe5d6"><b>STIPEND_RULE</b></td></tr><tr><td align="left"><b>PK</b> <u>rule_id</u></td></tr><tr><td align="left"><b>FK</b> version</td></tr><tr><td align="left" >code</td></tr><tr><td align="left" >amount</td></tr><tr><td align="left" >min_avg</td></tr><tr><td align="left" >min_research_points</td></tr></table>>];
  CALC [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#fff2cc"><b>CALCULATION</b></td></tr><tr><td align="left"><b>PK</b> <u>calc_id</u></td></tr><tr><td align="left"><b>FK</b> record_id</td></tr><tr><td align="left"><b>FK</b> version</td></tr><tr><td align="left" >rating</td></tr><tr><td align="left" >level</td></tr><tr><td align="left" >total</td></tr><tr><td align="left"><b>FK</b> calculated_by</td></tr><tr><td align="left" >calculated_at</td></tr></table>>];
  PAYMENT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#fff2cc"><b>PAYMENT</b></td></tr><tr><td align="left"><b>PK</b> <u>payment_id</u></td></tr><tr><td align="left"><b>FK</b> calc_id</td></tr><tr><td align="left" >stipend_code</td></tr><tr><td align="left" >amount</td></tr></table>>];
  AUDIT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#ededed"><b>AUDIT_LOG</b></td></tr><tr><td align="left"><b>PK</b> <u>log_id</u></td></tr><tr><td align="left" >ts</td></tr><tr><td align="left"><b>FK</b> actor</td></tr><tr><td align="left" >action</td></tr><tr><td align="left" >payload</td></tr></table>>];
  STUDENT -> RECORD [label=" имеет"];
  PERIOD -> RECORD [label=" за период"];
  RECORD -> ENTRY [label=" содержит"];
  CRITERION -> ENTRY [label=" по критерию"];
  USER -> ENTRY [label=" начислил"];
  RECORD -> CALC [label=" рассчитывается"];
  RULESET -> CALC [label=" по версии"];
  RULESET -> SRULE [label=" включает"];
  CALC -> PAYMENT [label=" назначает"];
  USER -> AUDIT [label=" действие"];
}