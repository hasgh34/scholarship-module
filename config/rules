# Правила расчёта стипендии и рейтинга.
# Все пороги, суммы и веса задаются здесь, код менять не нужно.
# Суммы указаны для примера: подставьте значения из положения о стипендиях.
version: "2026.1"

stipends:
  academic:
    title: "Академическая"
    amount: 2500
    min_avg: 4.0            # средний балл не ниже
  increased:
    title: "Повышенная (ПГАС)"
    amount: 5000
    min_avg: 4.5            # средний балл не ниже
    min_research_points: 20 # баллы за НИР не ниже
  social:
    title: "Социальная"
    amount: 3500            # нужна справка, задолженностей нет

rating:
  # веса критериев, сумма должна быть равна 1
  weights:
    avg: 0.5
    research: 0.3
    activity: 0.2
  # максимум по критерию (баллы сверх максимума обрезаются)
  max_points:
    avg: 5
    research: 100
    activity: 100
  # границы уровней рейтинга
  levels:
    - {name: "Высокий", min_rating: 75}
    - {name: "Средний", min_rating: 50}
    - {name: "Низкий",  min_rating: 0}
  debt_level: "Низкий"      # уровень при наличии задолженностей
